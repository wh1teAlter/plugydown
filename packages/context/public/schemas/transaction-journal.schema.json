{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugydown.dev/schemas/context/transaction-journal/v1.json",
  "title": "Plugydown Context transaction journal",
  "type": "object",
  "required": ["runId", "phase", "operations"],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "phase": {
      "enum": [
        "snapshot",
        "stage",
        "validate",
        "review",
        "concurrency-check",
        "commit",
        "verify",
        "recovery"
      ]
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "target", "state"],
        "additionalProperties": false,
        "properties": {
          "kind": { "enum": ["write", "replace", "delete", "restore"] },
          "target": { "type": "string", "minLength": 1, "description": "Repository-relative path." },
          "backup": { "type": "string", "minLength": 1 },
          "state": { "enum": ["planned", "applied", "reverted"] }
        }
      }
    },
    "recovery": {
      "type": "object",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": ["recovered", "manual-recovery-required", "failed"],
          "description": "failed never claims a completed rollback."
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
