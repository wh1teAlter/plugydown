{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugydown.dev/schemas/context/document/v1.json",
  "title": "Plugydown Context document front matter",
  "type": "object",
  "required": ["schema", "id", "description", "kind", "domain"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "plugydown.context.document/v1" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:\\.[a-z0-9]+(?:-[a-z0-9]+)*)*$",
      "description": "Repository-stable unique ID. Unchanged when the file moves."
    },
    "description": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["domain", "architecture", "decision", "guide", "reference", "reflection"] },
    "domain": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "relations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requires": { "$ref": "#/$defs/idList" },
        "related": { "$ref": "#/$defs/idList" },
        "supersedes": { "$ref": "#/$defs/idList" }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Repository-relative paths or bounded globs. Hard impact and fingerprint contract."
        },
        "symbols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "Routing hint only. Never a hard fingerprint input."
        }
      }
    },
    "loading": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "priority": { "type": "integer" } }
    }
  },
  "$defs": {
    "idList": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
