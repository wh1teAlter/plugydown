{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugydown.dev/schemas/context/runtime-response/v1.json",
  "title": "Plugydown Context runtime response",
  "type": "object",
  "required": ["protocol", "capability", "status"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "plugydown.context.runtime/v1" },
    "capability": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["success", "incomplete", "failed"],
      "description": "incomplete = insufficient evidence or authorization. failed = tool, schema, I/O, or recovery error."
    },
    "summary": { "type": "string", "description": "Short prompt-facing summary. Large results go to .scratch/." },
    "reportPath": { "type": "string", "description": "Repository-relative path under .scratch/." },
    "cursor": { "type": "string", "minLength": 1, "description": "Present when a budget bounded the result. Never means truncation." },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "severity": { "enum": ["error", "warning", "info"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "data": { "type": "object" }
  }
}
