{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugydown.dev/schemas/context/runtime-request/v1.json",
  "title": "Plugydown Context runtime request",
  "type": "object",
  "required": ["protocol", "capability"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "plugydown.context.runtime/v1" },
    "capability": {
      "enum": [
        "repository.inspect",
        "frontier.query",
        "graph.validate",
        "delta.compute",
        "growth.measure",
        "feedback.match",
        "role.envelope",
        "transaction.run"
      ]
    },
    "runId": { "type": "string", "minLength": 1 },
    "scope": { "type": "object" },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "estimatedTokens": { "type": "integer", "minimum": 1 }
      }
    },
    "cursor": { "type": "string", "minLength": 1 },
    "params": { "type": "object" }
  }
}
