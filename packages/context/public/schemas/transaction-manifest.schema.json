{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plugydown.dev/schemas/context/transaction-manifest/v1.json",
  "title": "Plugydown Context transaction manifest",
  "type": "object",
  "required": ["runId", "command", "mode", "scope", "authorization", "snapshot"],
  "additionalProperties": false,
  "properties": {
    "runId": { "type": "string", "minLength": 1 },
    "command": { "enum": ["init", "update", "prune"] },
    "mode": { "enum": ["bootstrap", "synchronize", "converge", "promote", "light", "deep"] },
    "scope": { "type": "object" },
    "authorization": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "enum": ["explicit-invocation", "confirmed-suggestion"] },
        "dryRun": { "type": "boolean" }
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["sourceState", "targets"],
      "additionalProperties": false,
      "properties": {
        "sourceState": { "type": "string", "minLength": 1 },
        "metaFingerprint": { "type": "string", "minLength": 1 },
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "operation"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "operation": { "enum": ["create", "rewrite", "merge", "split", "delete"] },
              "fingerprint": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "allowedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "stopConditions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
